[Unit]
Description=Sweep Monero deposit subaddresses into the hot wallet
After=network.target tor.service monerod.service

[Service]
Type=oneshot
User=kola
Group=kola
WorkingDirectory=/opt/kola
EnvironmentFile=/opt/kola/.env
ExecStart=/opt/kola/.venv/bin/python /opt/kola/manage.py sweep_monero_deposits
StandardOutput=journal
StandardError=journal
