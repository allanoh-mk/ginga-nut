[Unit]
Description=Create and verify an encrypted Kola Market database backup
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=kola
Group=kola
WorkingDirectory=/opt/kola
EnvironmentFile=/opt/kola/.env
EnvironmentFile=/etc/kola/backup.env
ExecStart=/opt/kola/scripts/backup.sh
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal
