# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production (DJANGO_DEBUG=false) requires exact v3 onion hostnames.
DJANGO_ONION_HOSTS=

POSTGRES_DB=kola_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
LOGIN_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0

# Rate requests are server-side, keyless, and require a Tor SOCKS5h listener.
RATE_FEED_SOCKS_PROXY=socks5h://127.0.0.1:9050
RATE_FEED_TIMEOUT_SECONDS=10

# Keep providers set to fake until every required provider setting is configured.
BTC_PROVIDER=fake
LTC_PROVIDER=fake
TRC20_PROVIDER=fake
XMR_PROVIDER=fake
BTC_CONFIRMATIONS=2
LTC_CONFIRMATIONS=6
TRC20_CONFIRMATIONS=20
XMR_CONFIRMATIONS=10

BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TETHER_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRC20_CONTRACT_WHITELIST=
TRC20_RATE_SYMBOL=
TRC20_TOKEN_DECIMALS=6
# Dotted local callable in the form package.module:function_name; it must
# derive a unique address without sending user details to a third party.
TRON_ADDRESS_DERIVER=
# Reserve must point to a wallet provisioned as view-only; all three URLs must differ.
MONERO_RESERVE_WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
MONERO_RESERVE_WALLET_RPC_USER=
MONERO_RESERVE_WALLET_RPC_PASSWORD=
MONERO_HOT_WALLET_RPC_URL=http://127.0.0.1:18084/json_rpc
MONERO_HOT_WALLET_RPC_USER=
MONERO_HOT_WALLET_RPC_PASSWORD=
MONERO_PAYOUT_WALLET_RPC_URL=http://127.0.0.1:18085/json_rpc
MONERO_PAYOUT_WALLET_RPC_USER=
MONERO_PAYOUT_WALLET_RPC_PASSWORD=
# Separate multisig coordinator; it must enforce independent participant approval
# and never expose signer keys to Kola. Do not set these to participant wallet RPCs.
MONERO_ESCROW_GATEWAY_URL=
MONERO_ESCROW_GATEWAY_ALLOWED_HOSTS=
MONERO_ESCROW_GATEWAY_SECRET=
MONERO_ESCROW_CALLBACK_URL=
MONERO_ESCROW_RELEASE_ADDRESS=
# Local monerod RPC; run the daemon with its peer traffic routed through Tor.
MONEROD_RPC_URL=http://127.0.0.1:18081/get_info
MONEROD_TOR_PROXY=127.0.0.1:9050

WITHDRAWAL_FEE_BASE_UNITS=0
WITHDRAWAL_MAX_TX_BASE_UNITS=200000000
WITHDRAWAL_MAX_HOURLY_BASE_UNITS=1500000000
WITHDRAWAL_MAX_DAILY_BASE_UNITS=6000000000
RESERVE_HOT_BALANCE_BASE_UNITS=0
RESERVE_COLD_BALANCE_BASE_UNITS=0
# Public statement signed with an Ed25519 seed encoded as base64.
# Generate a seed with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CANARY_STATEMENT=
CANARY_SIGNING_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
